# ──────────────────────────────────────────────
# FoodLink Auth Service — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and fill in real values for local dev.
# Docker Compose reads this file automatically.

# ── App ────────────────────────────────────────
ENVIRONMENT=local                          # local | dev | staging | prod
DEBUG=true
APP_NAME=FoodLink Auth
LOG_LEVEL=DEBUG                            # DEBUG | INFO | WARNING | ERROR

# ── PostgreSQL ────────────────────────────────
DB_URL=postgresql+asyncpg://foodlink:foodlink@localhost:5455/foodlink_auth

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6385/0

# ── JWT (placeholder — generate RSA keys later) ─
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── OTP / SMS delivery ────────────────────────
# console logs the full OTP message to stdout (see sms_console_send in the
# API logs) — perfect for local manual testing without a real SMS gateway.
# africastalking | console
SMS_PROVIDER=console
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Africa's Talking credentials (only needed when SMS_PROVIDER=africastalking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ── Session ───────────────────────────────────
SESSION_TTL_MINUTES=60

# ── Host ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
