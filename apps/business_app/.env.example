# ── FoodLink Business App — Environment Configuration ──────────────
# Environment-config approach: flutter_dotenv loads .env at runtime
# (declared as an asset in pubspec.yaml; loaded in lib/main.dart).
# Copy this file to `.env` and adjust the base URLs for your target.
# For compile-time overrides (e.g. CI/CD), use --dart-define instead.
# ═════════════════════════════════════════════════════════════════════

# Identity Service (services/identity-service, host port 8009)
# Which host depends on your run target:
#   Android emulator   -> http://10.0.2.2:8009   (alias for the host's localhost)
#   iOS simulator      -> http://localhost:8009
#   Linux/macOS/Windows desktop -> http://localhost:8009
#   Physical device    -> http://<your-LAN-IP>:8009 (e.g. http://192.168.1.50:8009)
#                        Find it with: ip addr | grep "inet " (Linux),
#                        ipconfig getifaddr en0 (macOS),
#                        ipconfig (Windows). Device must be on the same network.
IDENTITY_BASE_URL=http://localhost:8009

# Inventory Service (services/inventory-service, port 8100)
INVENTORY_BASE_URL=http://10.0.2.2:8100

# POS Service (services/pos-service, port 8200)
POS_BASE_URL=http://10.0.2.2:8200
